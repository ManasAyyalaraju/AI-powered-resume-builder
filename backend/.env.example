# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Uncomment and set if using a different base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model tiering. openai_model_fast is used for parsing,
# classification, categorization, and the bounded verifier re-ask.
# openai_model_generate is used for the actual tailoring/bullet-generation
# call - raise this independently once a stronger model is chosen; both
# default to gpt-4o-mini if unset.
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_GENERATE=gpt-4o-mini

# Optional: max retries for transient OpenAI errors (rate limits, timeouts).
# OPENAI_MAX_RETRIES=2
